{
  "name": "adaptive-strength-hypertrophy-app",
  "private": true,
  "version": "0.40.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE_PATH=/adaptive-strength-hypertrophy-app-pages/ npm run build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "qc:ui": "node scripts/qc-ui-boundaries.mjs",
    "qc:pages": "node scripts/qc-pages-build.mjs",
    "qc:backend": "node scripts/qc-supabase-schema.mjs",
    "check:pages": "npm run build:pages && npm run qc:pages",
    "check": "npm run qc:ui && npm run qc:backend && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@vitejs/plugin-react": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "nanoid": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
